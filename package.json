{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API for CCS Vault, handling business logic, authentication, and database operations.",
  "main": "dist/server.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "test": "cross-env NODE_ENV=test tsx --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "migrate:up": "tsx src/config/migrate.ts up",
    "migrate:down": "tsx src/config/migrate.ts down"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dlsu-lscs/ccs-vault-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/dlsu-lscs/ccs-vault-api/issues"
  },
  "homepage": "https://github.com/dlsu-lscs/ccs-vault-api#readme",
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "express-rate-limit": "^7.5.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "cross-env": "^7.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "body-parser": "^2.4.0"
  }
}
