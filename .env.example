# Copy to .env for local development. Never commit .env or real values.

# Where each value lives per environment: see docs/environment.md

# Runtime: Environment mode (development | test | staging | production)
NODE_ENV=development

# Runtime: API port (Dokploy/container should match the exposed port)
PORT=3001

# Runtime, secret: PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ccs_vault

# Test database connection string (used during tests, defaults to ccs_vault_test)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ccs_vault_test

# Runtime, secret: Google OAuth client ID for verifying ID tokens
GOOGLE_CLIENT_ID=

# Runtime (planned): comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000

# Runtime, secret (planned, #25): Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
